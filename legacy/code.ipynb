df = get_ethiopia_data()
num_sites = len(df)

# ==========================================

# 2. THE QUBO MODEL & SOLVER ENGINE
# ==========================================
def run_optimization(target_budget, sweeps=1000):
    print(f"⚙️ Formulating QUBO for Budget: ${target_budget:,} ...")

    # Define Binary Variables (1 = Build, 0 = Do Not Build)
    x = Array.create('site', shape=num_sites, vartype='BINARY')

    # Extract arrays for faster math
    costs = df["Installation_Cost_USD"].values
    pops = df["Population_Coverage"].values
    energy = df["Energy_Capacity_kWh_day"].values

    # --- The Objective Function (Hamiltonian) ---
    # 1. Maximize Population & Energy (We minimize the negative)
    obj_pop = -1.0 * sum(pops[i] * x[i] for i in range(num_sites))
    obj_energy = -0.5 * sum(energy[i] * x[i] for i in range(num_sites))

    # 2. Budget Penalty (Heavy penalty if cost exceeds or deviates from budget)
    # Scaling factor (theta) keeps the numbers manageable for the solver
    theta = 1e-8
    con_budget = theta * (sum(costs[i] * x[i] for i in range(num_sites)) - target_budget)**2

    # Compile Model
    H = obj_pop + obj_energy + con_budget
    model = H.compile()
    qubo, offset = model.to_qubo()

    # Run Simulated Annealing (D-Wave Neal)
    sampler = neal.SimulatedAnnealingSampler()
    sampleset = sampler.sample_qubo(qubo, num_reads=10, num_sweeps=sweeps)

    # Extract Best Result
    best_sample = sampleset.first.sample
    x_result = np.array([best_sample[f'site[{i}]'] for i in range(num_sites)])

    return x_result, sampleset.first.energy

# ==========================================
# 3. GEOSPATIAL VISUALIZATION (FOLIUM)
# ==========================================
def generate_map(df, x_result, budget):
    """Creates an interactive map of selected microgrids."""
    # Center map on Ethiopia
    m = folium.Map(location=[9.145, 40.4897], zoom_start=6, tiles="CartoDB positron")

    df['Selected'] = x_result

    for _, row in df.iterrows():
        if row['Selected'] == 1:
            color = 'green'
            fill = '#00FF00'
            status = 'SELECTED'
        else:
            color = 'red'
            fill = '#FF0000'
            status = 'Skipped'

        popup_text = f"<b>{row['Site_ID']}</b><br>Status: {status}<br>Cost: ${row['Installation_Cost_USD']:,}<br>Pop: {row['Population_Coverage']:,}"

        folium.CircleMarker(
            location=[row['Y_coord'], row['X_coord']],
            radius=6 if row['Selected'] == 1 else 3,
            color=color,
            fill=True,
            fill_color=fill,
            fill_opacity=0.7,
            popup=folium.Popup(popup_text, max_width=200)
        ).add_to(m)

    map_path = f"Ethiopia_Microgrid_Map_Budget_{budget}.html"
    m.save(map_path)
    print(f"🗺️ Map generated: {map_path} (Open in browser to view)")
    return m

# ==========================================
# 4. CONVERGENCE & METRICS PLOTTING
# ==========================================
def run_convergence_analysis(target_budget):
    print("📈 Running Convergence Analysis... (This may take a minute)")
    history = []
    sweep_steps = list(range(10, 100, 20)) + list(range(100, 1001, 100))

    for sweeps in sweep_steps:
        x_res, energy = run_optimization(target_budget, sweeps)
        real_cost = np.sum(df["Installation_Cost_USD"].values * x_res)
        real_pop = np.sum(df["Population_Coverage"].values * x_res)

        history.append({
            "Sweeps": sweeps,
            "Energy": energy,
            "Cost": real_cost,
            "Population": real_pop
        })

    df_hist = pd.DataFrame(history)

    # --- Plotting ---
    fig, axes = plt.subplots(1, 3, figsize=(18, 5))
    sns.set_theme(style="whitegrid")

    # 1. Energy Convergence
    sns.lineplot(ax=axes[0], data=df_hist, x="Sweeps", y="Energy", color="purple", marker="o")
    axes[0].set_title("QUBO Hamiltonian Energy Minimization")
    axes[0].set_ylabel("System Energy (Lower is Better)")

    # 2. Cost Stabilization
    sns.lineplot(ax=axes[1], data=df_hist, x="Sweeps", y="Cost", color="blue", marker="o")
    axes[1].axhline(target_budget, color='red', linestyle='--', label="Target Budget")
    axes[1].set_title("Total Cost vs Allowed Budget")

    # 3. Population Maximization
    sns.lineplot(ax=axes[2], data=df_hist, x="Sweeps", y="Population", color="green", marker="o")
    axes[2].set_title("Population Coverage Growth")

    plt.tight_layout()
    plt.savefig("Convergence_Plots.png", dpi=300)
    plt.show()

